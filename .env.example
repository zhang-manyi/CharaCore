# Copy to .env in the project root. Never commit the populated .env.
# Official OpenAI API.
CHARACORE_JUDGE_BASE_URL=https://api.openai.com/v1
CHARACORE_JUDGE_API_KEY=
CHARACORE_JUDGE_MODEL=gpt-6-astra
# responses or chat_completions
CHARACORE_JUDGE_API_STYLE=chat_completions
# BASE_URL is the API prefix; the selected endpoint is appended automatically.
# Prefer a fixed model revision, not a changing alias. No policy model is sent.
CHARACORE_JUDGE_MAX_TOKENS=4096
CHARACORE_JUDGE_TIMEOUT_SECONDS=120
# Per process, including failed HTTP requests and retries. Two ranks have two budgets.
CHARACORE_JUDGE_MAX_CALLS=100
# Conservative UTF-8 byte bound, not the provider's exact token count.
CHARACORE_JUDGE_MAX_INPUT_BYTES=16384
# Enable JSON response mode only if supported by your provider: true / false
CHARACORE_JUDGE_JSON_MODE=true
